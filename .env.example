# Calendly event opened after a successful contact form submission.
NEXT_PUBLIC_CALENDLY_URL=your_calendly_url

# Secret used to sign Payload's JWTs and cookies. Generate one with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/byldd-landing-site
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/byldd-landing-site
DATABASE_URI=mongodb://127.0.0.1:27017/byldd-landing-site

# Public URL of this app, used for admin links and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
